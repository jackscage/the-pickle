# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored and never leaves your machine.
#
# Find the Supabase values in Supabase: Project Settings -> API

# Safe to be public. These two are compiled into the browser bundle by
# design -- anyone who opens the app can read them. That is fine: they only
# grant what Row-Level Security allows.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# NOT safe to be public. This key bypasses every security policy in the
# database. It must only ever exist server-side -- in Vercel's environment
# variable settings and in your local .env.local. Never paste it into a
# chat, a commit, or any file that starts with NEXT_PUBLIC_.
#
# In this project it has exactly one job: the gated moderation path that
# identifies the author of reported content (PROJECT_SPEC.md section 9).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional. Where the emailed sign-in links should send people.
#
# Leave it unset and the app works it out from the address the request came
# in on, which is usually right and means preview deployments send links back
# to themselves. Set it if links ever need to point at one fixed address --
# for example https://thepickle.vercel.app
NEXT_PUBLIC_SITE_URL=
